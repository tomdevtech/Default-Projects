{
  "name": "default-projects",
  "displayName": "Default Projects",
  "description": "Create projects from your own reusable templates (folders, files, content) - from a sidebar, a Quick Pick or the Command Palette.",
  "version": "0.1.0",
  "publisher": "tomdevtech",
  "license": "MIT",
  "icon": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomdevtech/Default-Projects"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "project template",
    "scaffold",
    "boilerplate",
    "starter",
    "snippets"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "default-projects.CreatePredefinedPythonProject",
        "title": "Create Python Project",
        "category": "Default Projects"
      },
      {
        "command": "default-projects.CreateCustomProject",
        "title": "New Template...",
        "category": "Default Projects",
        "icon": "$(add)"
      },
      {
        "command": "default-projects.CreateFromTemplate",
        "title": "Create Project from Template...",
        "category": "Default Projects",
        "icon": "$(new-folder)"
      },
      {
        "command": "default-projects.EditTemplate",
        "title": "Edit Template...",
        "category": "Default Projects",
        "icon": "$(edit)"
      },
      {
        "command": "default-projects.DeleteTemplate",
        "title": "Delete Template...",
        "category": "Default Projects",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "default-projects",
          "title": "Default Projects",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "default-projects": [
        {
          "id": "defaultProjectsView",
          "name": "Templates",
          "icon": "images/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "defaultProjectsView",
        "contents": "You have no templates yet.\n[New Template](command:default-projects.CreateCustomProject)\n[Create Python Project](command:default-projects.CreatePredefinedPythonProject)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "default-projects.CreateCustomProject",
          "when": "view == defaultProjectsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "default-projects.CreateFromTemplate",
          "when": "view == defaultProjectsView && viewItem == template",
          "group": "inline@1"
        },
        {
          "command": "default-projects.EditTemplate",
          "when": "view == defaultProjectsView && viewItem == template",
          "group": "inline@2"
        },
        {
          "command": "default-projects.DeleteTemplate",
          "when": "view == defaultProjectsView && viewItem == template",
          "group": "inline@3"
        },
        {
          "command": "default-projects.CreateFromTemplate",
          "when": "view == defaultProjectsView && viewItem == template",
          "group": "1_actions@1"
        },
        {
          "command": "default-projects.EditTemplate",
          "when": "view == defaultProjectsView && viewItem == template",
          "group": "1_actions@2"
        },
        {
          "command": "default-projects.DeleteTemplate",
          "when": "view == defaultProjectsView && viewItem == template",
          "group": "1_actions@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && mocha --ui tdd \"out/test/**/*.test.js\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.0.0",
    "mocha": "^10.8.2",
    "typescript": "^5.9.3"
  }
}
